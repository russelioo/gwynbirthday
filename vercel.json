{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "birthday-site": {
      "root": "birthday-site",
      "framework": "vite",
      "buildCommand": "npm run build:static",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "birthday-site"
      }
    }
  ]
}
